diff --git a/packages/core/src/zig/build.zig b/packages/core/src/zig/build.zig
index 9034757..98882d2 100644
--- a/packages/core/src/zig/build.zig
+++ b/packages/core/src/zig/build.zig
@@ -162,8 +162,13 @@ fn addNativeAudioDependencies(
     switch (target.result.os.tag) {
         .macos => addMacOSSystemLibraries(b, artifact, macos_sdk_path.?),
         .linux => {
-            artifact.linkSystemLibrary("dl");
-            artifact.linkSystemLibrary("pthread");
+            // Android/Bionic folds dl and pthread into libc.so — no separate stubs in the NDK.
+            // Requesting them causes Zig to fail with "unable to find dynamic system library".
+            const abi = target.result.abi;
+            if (abi != .android and abi != .androideabi) {
+                artifact.linkSystemLibrary("dl");
+                artifact.linkSystemLibrary("pthread");
+            }
         },
         else => {},
     }
@@ -451,6 +456,27 @@ fn buildTarget(
 
     addNativeAudioDependencies(b, lib, target, macos_sdk_path);
 
+    // On Android, explicitly link the NDK libc.so stub so dlopen() can resolve
+    // symbols like getauxval. Zig's linkLibC() emits -lc but doesn't always
+    // produce a NEEDED: libc.so entry in the .so without a direct path hint.
+    const os_tag = target.result.os.tag;
+    const abi = target.result.abi;
+    if (os_tag == .linux and (abi == .android or abi == .androideabi)) {
+        const ndk_lib: ?[]const u8 = blk: {
+            if (std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_LIB_DIR") catch null) |dir| {
+                break :blk dir;
+            }
+            if (std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_HOME") catch null) |ndk_home| {
+                break :blk std.fmt.allocPrint(b.allocator, "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android/24", .{ndk_home}) catch null;
+            }
+            break :blk null;
+        };
+        if (ndk_lib) |dir| {
+            const libc_path = std.fmt.allocPrint(b.allocator, "{s}/libc.so", .{dir}) catch unreachable;
+            lib.addObjectFile(.{ .cwd_relative = libc_path });
+        }
+    }
+
     const install_dir = b.addInstallArtifact(lib, .{
         .dest_dir = .{
             .override = .{
