diff --git a/packages/core/src/zig/build.zig b/packages/core/src/zig/build.zig
index 1550ef2..bc1b165 100644
--- a/packages/core/src/zig/build.zig
+++ b/packages/core/src/zig/build.zig
@@ -273,6 +273,23 @@ fn buildTarget(
         .linkage = .dynamic,
     });
 
+    // On Android, explicitly link the NDK libc.so stub so dlopen() can resolve
+    // symbols such as getauxval. Zig does not add a NEEDED: libc.so entry for
+    // this library by default, and Android's dynamic linker will not use the
+    // process' already-loaded libc to satisfy unresolved symbols from dlopen().
+    const os_tag = target.result.os.tag;
+    const abi = target.result.abi;
+    if (os_tag == .linux and (abi == .android or abi == .androideabi)) {
+        if (b.graph.env_map.get("ANDROID_NDK_HOME")) |ndk_home| {
+            const libc_path = std.fmt.allocPrint(
+                b.allocator,
+                "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android/24/libc.so",
+                .{ndk_home},
+            ) catch unreachable;
+            lib.addObjectFile(.{ .cwd_relative = libc_path });
+        }
+    }
+
     const install_dir = b.addInstallArtifact(lib, .{
         .dest_dir = .{
             .override = .{
