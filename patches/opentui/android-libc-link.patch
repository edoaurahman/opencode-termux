+    // linkLibC() fails for Android targets ("unable to provide libc for target").
+    // Add NDK sysroot include paths manually and rely on the explicit libc.so
+    // added as an object file in buildTarget.
+    const shim_abi = target.result.abi;
+    if (shim_abi == .android or shim_abi == .androideabi) {
+        if (b.graph.env_map.get("ANDROID_NDK_HOME")) |ndk_home| {
+            const sysroot = std.fmt.allocPrint(b.allocator, "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot", .{ndk_home}) catch unreachable;
+            artifact.addSystemIncludePath(.{ .cwd_relative = std.fmt.allocPrint(b.allocator, "{s}/usr/include", .{sysroot}) catch unreachable });
+            artifact.addSystemIncludePath(.{ .cwd_relative = std.fmt.allocPrint(b.allocator, "{s}/usr/include/aarch64-linux-android", .{sysroot}) catch unreachable });
+        }
+    } else {
+        artifact.linkLibC();
+    }
     artifact.addCSourceFile(.{
         .file = b.path("miniaudio_shim.c"),
